# floreria-app — Variables de entorno (plantilla sin valores reales)
# Copia a .env.local y complétala. Nunca versiones .env.local.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Pública (llega al navegador, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secreta: SOLO servidor. Omite RLS. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub Models (visión del cotizador): token fine-grained con permiso "Models: read"
# Modelo opcional (por defecto openai/gpt-4o-mini)
# GITHUB_MODEL=openai/gpt-4o-mini
GITHUB_TOKEN=

# ─── Panel de administración ───────────────────────────────
# Secreto para firmar la cookie de sesión: mínimo 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo cierra todas las sesiones abiertas.
ADMIN_SESSION_SECRET=
# Hash PBKDF2 de la contraseña del panel:  npm run hash-admin-password
ADMIN_PASSWORD_HASH=
# Legado (texto plano). Úsalo solo hasta generar ADMIN_PASSWORD_HASH y luego elimínalo.
# ADMIN_PASSWORD=

# Vercel Cron (/api/cron/limpiar): secreto que Vercel envía como Bearer
CRON_SECRET=

# Número de WhatsApp público de la tienda (se muestra en el sitio)
NEXT_PUBLIC_WHATSAPP_NUMBER=
